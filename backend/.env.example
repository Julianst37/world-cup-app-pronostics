# Firebase Admin SDK credentials
# Copy this file to .env and fill in your values
# NEVER commit .env or serviceAccountKey.json to git

FIREBASE_PROJECT_ID=world-cup-app-pronostics
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@world-cup-app-pronostics.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id

# World Cup 2026 API
WC_API_URL=https://api.wc2026api.com
WC_API_TOKEN=your-bearer-token-here
