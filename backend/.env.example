# Firebase Admin SDK credentials
# Copy this file to .env and fill in your values
# NEVER commit .env or serviceAccountKey.json to git

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=your-service-account-email
FIREBASE_CLIENT_ID=your-client-id
FIREBASE_WEB_API_KEY=your-firebase-web-api-key

# World Cup 2026 API
WC_API_URL=https://api.wc2026api.com
WC_API_TOKEN=replace-with-your-api-token

# Forgot password email service
PORT=3001
ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173/auth/reset-password
RESEND_API_KEY=replace-with-your-resend-api-key
RESEND_FROM=World Cup 2026 Pronosticos <no-reply@example.com>
SUPPORT_EMAIL=soporte@example.com
APP_NAME=World Cup 2026 Pronosticos
