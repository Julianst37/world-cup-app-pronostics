generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- Users -----------------------------------------------------------------
// id = Firebase Auth UID
model User {
  id                    String    @id
  email                 String?   @unique
  displayName           String?
  username              String?   @unique
  photoURL              String?
  favoriteTeam          String?
  firstName             String?
  lastName              String?
  isActive              Boolean   @default(true)
  isAdmin               Boolean   @default(false)
  passwordChangeCount   Int       @default(0)
  passwordChangeLimit   Int       @default(3)
  lastPasswordChangedAt DateTime?
  lastSupportPasswordAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  participants       Participant[]
  predictions        Prediction[]
  userNotifications  Notification[] @relation("UserNotifications")
  adminNotifications Notification[] @relation("AdminNotifications")
  fcmTokens          FcmToken[]
}

// --- Tournaments ------------------------------------------------------------
model Tournament {
  id                    String   @id @default(cuid())
  name                  String
  description           String?
  adminId               String
  inviteCode            String   @unique
  memberCount           Int      @default(1)
  status                String   @default("active")
  isPublic              Boolean  @default(false)
  requiresApproval      Boolean  @default(false)
  showPredictionsAlways Boolean  @default(false)
  maxUsers              Int?
  predictionLockMinutes Int      @default(10)
  secondRoundMultiplier Float    @default(2)
  pointConfig           Json     @default("{\"exact\":3,\"difference\":2,\"winner\":1}")
  prizeConfig           Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  participants  Participant[]
  notifications Notification[]
  standing      Standing?
}

// --- Matches ----------------------------------------------------------------
model Match {
  id            String   @id @default(cuid())
  homeTeam      String
  awayTeam      String
  date          String
  time          String
  status        String   @default("scheduled")
  round         String?
  group         String?
  homeScore     Int?
  awayScore     Int?
  homeTeamCode  String?
  awayTeamCode  String?
  homeTeamFlag  String?
  awayTeamFlag  String?
  configured    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  predictions       Prediction[]
  matchNotification MatchNotification?
}

// --- Participants -----------------------------------------------------------
model Participant {
  id           String   @id @default(cuid())
  userId       String
  tournamentId String
  status       String   @default("active")
  role         String   @default("member")
  points       Int      @default(0)
  joinedAt     DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id])
  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([userId, tournamentId])
}

// --- Predictions ------------------------------------------------------------
model Prediction {
  id           String   @id
  userId       String
  userName     String?
  matchId      String
  tournamentId String
  homeScore    Int?
  awayScore    Int?
  points       Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  match Match @relation(fields: [matchId], references: [id])

  @@index([userId, tournamentId])
  @@index([tournamentId, matchId])
}

// --- Notifications ----------------------------------------------------------
model Notification {
  id           String   @id @default(cuid())
  type         String
  userId       String?
  adminId      String?
  tournamentId String?
  read         Boolean  @default(false)
  createdAt    DateTime @default(now())

  user       User?       @relation("UserNotifications", fields: [userId], references: [id])
  admin      User?       @relation("AdminNotifications", fields: [adminId], references: [id])
  tournament Tournament? @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
}

// --- FCM Tokens -------------------------------------------------------------
model FcmToken {
  token     String   @id
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// --- Match Notifications (cron dedup) ---------------------------------------
model MatchNotification {
  matchId    String   @id
  notifiedAt DateTime @default(now())
  matchDate  String?
  matchTime  String?

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

// --- Standings ---------------------------------------------------------------
model Standing {
  tournamentId String   @id
  entries      Json
  updatedAt    DateTime @updatedAt

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
}

// --- Meta -------------------------------------------------------------------
model Meta {
  id               String   @id
  lastUpdated      DateTime @default(now())
  updatedMatchId   String?
  updatedMatchData Json?
}

// --- Platform Settings -------------------------------------------------------
model PlatformSettings {
  id        String   @id @default("global")
  data      Json     @default("{}")
  updatedAt DateTime @updatedAt
}
